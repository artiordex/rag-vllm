# PostgreSQL with the pgvector extension
DATABASE_URL=postgresql://ragvllm:ragvllm-dev-only@localhost:55433/ragvllm
DATABASE_CONNECT_TIMEOUT=3

# RAG API (11000s dedicated AI/RAG port range)
API_PORT=11020

# flag = real BGE embeddings, hash = deterministic smoke-test embeddings
EMBEDDING_PROVIDER=flag
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# Keep BGE on CPU so vLLM has predictable VRAM headroom on a 16 GiB GPU.
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false

CHUNK_SIZE=1600
CHUNK_OVERLAP=240
RETRIEVAL_TOP_K=5
MAX_UPLOAD_BYTES=20971520
INGEST_AUTO_MASK_PII=true
# The built-in synonym list is exploratory only; keep replacements off unless
# the operator explicitly accepts its non-authoritative mappings.
INGEST_APPLY_LOCAL_TERM_REPLACEMENTS=false

# vLLM model server
# Use a Hugging Face model name or a local model path, not an Ollama tag.
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
VLLM_SERVED_MODEL_NAME=rag-vllm-model
VLLM_MAX_MODEL_LEN=8192
VLLM_HOST_PORT=11435
VLLM_GPU_MEMORY_UTILIZATION=0.75
VLLM_API_KEY=vllm-local
# Set this when the selected Hugging Face model requires authentication.
HF_TOKEN=

# RAG API's OpenAI-compatible LLM client
LLM_BASE_URL=http://127.0.0.1:11435/v1
LLM_API_KEY=vllm-local
LLM_MODEL=rag-vllm-model

# Set this before exposing the API outside localhost/VPN.
# RAG_LAB_API_KEY=change-me
# Leave CORS disabled for the NAS-only setup. If a separate trusted web app is added,
# list its exact origins here, comma-separated.
# RAG_CORS_ORIGINS=https://portal.example.internal
