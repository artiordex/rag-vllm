# PostgreSQL + pgvector
DATABASE_URL=postgresql://ragvllm:ragvllm-dev-only@localhost:55433/ragvllm
DATABASE_CONNECT_TIMEOUT=3

# API: 11000번대 전용 포트
API_HOST=127.0.0.1
API_PORT=11020
# RAG-vLLM is an API service; keep the unauthenticated development dashboard off.
RAG_DASHBOARD_ENABLED=false

# flag: 실제 BGE, hash: 테스트용 임베딩
EMBEDDING_PROVIDER=flag
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# BGE는 vLLM GPU 여유를 위해 CPU 실행
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false
EMBEDDING_GPU_MEMORY_FRACTION=0.25
EMBEDDING_MAX_CONCURRENT_CALLS=1

CHUNK_SIZE=1600
CHUNK_OVERLAP=240
PARENT_CHILD_CHUNKING_ENABLED=false
CHILD_CHUNK_SIZE=280
CHILD_CHUNK_OVERLAP=40
PARENT_CHUNK_SIZE=1200
PARENT_CHUNK_OVERLAP=120
HYDE_ENABLED=false
QUERY_ROUTER_ENABLED=false
CONTEXTUAL_RETRIEVAL_ENABLED=false
MULTI_QUERY_ENABLED=false
CRAG_ENABLED=false
RETRIEVAL_TOP_K=5
MAX_UPLOAD_BYTES=20971520
INGEST_AUTO_MASK_PII=true
# 비공식 용어 치환은 검토 후 활성화
INGEST_APPLY_LOCAL_TERM_REPLACEMENTS=false

# vLLM 모델 서버
# Hugging Face 모델명 또는 로컬 경로 사용
VLLM_IMAGE=vllm/vllm-openai:v0.30.0
VLLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
VLLM_SERVED_MODEL_NAME=rag-vllm-model
VLLM_MAX_MODEL_LEN=8192
VLLM_HOST_PORT=11435
VLLM_GPU_MEMORY_UTILIZATION=0.75
VLLM_API_KEY=vllm-local
# HF 인증 필요 시 토큰 설정
HF_TOKEN=

# OpenAI 호환 LLM 클라이언트
LLM_BASE_URL=http://127.0.0.1:11435/v1
LLM_API_KEY=vllm-local
LLM_MODEL=rag-vllm-model
# Request aliases map only to adapters that vLLM already serves as model names.
LLM_LORA_ADAPTERS_JSON=

# Optional distributed semantic cache. Install with `uv sync --extra redis-cache`.
# Use rediss:// for TLS and configure a Redis-side maxmemory/eviction policy.
SEMANTIC_CACHE_REDIS_URL=
SEMANTIC_CACHE_TTL_SECONDS=1800
SEMANTIC_CACHE_MAX_ENTRIES=256

# A separate, read-only DuckDB aggregate route for CSV/TSV/XLSX tables.
STRUCTURED_QUERY_ENABLED=true

# 외부 공개 전 API 키 설정
# RAG_LAB_API_KEY=change-me
# 앱별 챗봇 키는 README의 RAG_CHAT_CLIENTS_JSON 형식으로 서버 환경에만 설정
# RAG_CHAT_CLIENTS_JSON=
# MOE 품질진단 개발 API
# 비우면 MOE 프록시 비활성화
MOE_DQ_API_BASE_URL=http://127.0.0.1:8001
MOE_DQ_API_TIMEOUT_SECONDS=30
# NAS 전용은 CORS 비활성화
# 별도 웹 앱 사용 시 정확한 origin 입력
# RAG_CORS_ORIGINS=https://portal.example.internal

# 다중 벡터 저장소 설정 (pgvector, qdrant, weaviate, cpp_engine)
VECTOR_STORE_TYPE=pgvector
QDRANT_URL=http://127.0.0.1:6333
WEAVIATE_URL=http://127.0.0.1:8080
WEAVIATE_GRPC_HOST=
WEAVIATE_GRPC_PORT=50051
WEAVIATE_API_KEY=
# C++ 엔진은 프로세스 메모리 전용이며 재시작 시 색인이 사라짐
CPP_VECTOR_ENGINE_LIBRARY=
CPP_ENGINE_MAX_VECTORS=25000

# 보안 가드레일 (Prompt Injection, 탈옥, PII 보호)
GUARDRAILS_ENABLED=true
GUARDRAILS_BLOCK_ON_INJECTION=true
GUARDRAILS_MASK_PII=true

# 로컬 LMOps 관측성 및 트레이싱
LMOPS_ENABLED=true
LMOPS_LOG_FILE=data/lmops_traces.jsonl
# Raw prompts/answers are omitted from traces by default. Enable only with an approved data policy.
LMOPS_STORE_QUERY_TEXT=false
LMOPS_STORE_ANSWER_TEXT=false
LMOPS_STORE_FEEDBACK_TEXT=false
LMOPS_STORE_USER_ID=false

# 로컬 RAG 정량 평가 판정 모델 (Zero-Cloud, 로컬 vLLM 직접 연동)
EVAL_JUDGE_MODEL=rag-vllm-model
EVAL_JUDGE_BASE_URL=http://127.0.0.1:11435/v1
