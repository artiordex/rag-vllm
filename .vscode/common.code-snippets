  // TypeScript: 타입·비동기·Vitest
  "TypeScript interface": {
    "scope": "typescript,typescriptreact",
    "prefix": "tsinterface",
    "body": [
      "export interface ${1:Name} {",
      "\t${0:id: string;}",
      "}"
    ],
    "description": "TypeScript 인터페이스"
  },
  "TypeScript async function": {
    "scope": "typescript,typescriptreact",
    "prefix": "tsasync",
    "body": [
      "export async function ${1:functionName}(${2:}): Promise<${3:void}> {",
      "\t$0",
      "}"
    ],
    "description": "Promise 반환 비동기 함수"
  },
  "Vitest test": {
    "scope": "typescript,typescriptreact,javascript,javascriptreact",
    "prefix": "vitest",
    "include": ["*.test.ts", "*.spec.ts", "*.test.tsx", "*.spec.tsx", "*.test.js", "*.spec.js"],
    "body": [
      "import { describe, expect, it } from \"vitest\";",
      "",
      "describe(\"${1:unit}\", () => {",
      "\tit(\"${2:expected behavior}\", () => {",
      "\t\texpect(${3:actual}).to${4|Be,Equal,StrictEqual|}(${5:expected});",
      "\t});",
      "});"
    ],
    "description": "Vitest 테스트 블록"
  },
  "React TypeScript component": {
    "scope": "typescriptreact",
    "prefix": "tsxcomponent",
    "include": ["*.tsx"],
    "body": [
      "export function ${1:ComponentName}() {",
      "\treturn (",
      "\t\t<div>$0</div>",
      "\t);",
      "}"
    ],
    "description": "TypeScript React 함수형 컴포넌트"
  },
  "React JavaScript component": {
    "scope": "javascriptreact",
    "prefix": "jsxcomponent",
