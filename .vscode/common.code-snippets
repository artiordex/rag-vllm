  // MCP: 프로젝트에서 쓰는 Python·TypeScript SDK
  "Python FastMCP server": {
    "scope": "python",
    "prefix": "pymcp",
    "body": [
      "from mcp.server.fastmcp import FastMCP",
      "",
      "mcp = FastMCP(\"${1:server-name}\")",
      "",
      "@mcp.tool()",
      "async def ${2:tool_name}(query: str) -> dict[str, str]:",
      "    \"\"\"${3:도구 설명}\"\"\"",
      "    return {\"result\": query}",
      "",
      "def main() -> None:",
      "    mcp.run()",
      "",
      "if __name__ == \"__main__\":",
      "    main()"
    ],
    "description": "Python FastMCP 서버와 도구"
  },
  "TypeScript MCP server": {
    "scope": "typescript",
    "prefix": "mcpserver",
    "body": [
      "import { McpServer } from \"@modelcontextprotocol/server\";",
      "import { serveStdio } from \"@modelcontextprotocol/server/stdio\";",
      "import * as z from \"zod/v4\";",
      "",
      "function createServer(): McpServer {",
      "    const server = new McpServer({ name: \"${1:server-name}\", version: \"0.1.0\" });",
      "    server.registerTool(",
      "        \"${2:tool_name}\",",
      "        {",
      "            description: \"${3:도구 설명}\",",
      "            inputSchema: z.object({ query: z.string() }),",
      "        },",
      "        async ({ query }) => ({ content: [{ type: \"text\", text: query }] }),",
      "    );",
      "    return server;",
      "}",
      "",
      "void serveStdio(createServer);"
    ],
    "description": "TypeScript MCP stdio 서버와 입력 검증 도구"
  },
  "TypeScript MCP stdio client": {
    "scope": "typescript",
    "prefix": "mcpclient",
    "body": [
      "import { Client } from \"@modelcontextprotocol/client\";",
      "import { StdioClientTransport } from \"@modelcontextprotocol/client/stdio\";",
      "",
      "const client = new Client({ name: \"${1:client-name}\", version: \"0.1.0\" });",
      "const transport = new StdioClientTransport({",
      "    command: \"${2:node}\",",
      "    args: [\"${3:dist/server.js}\"],",
      "});",
      "",
      "await client.connect(transport);",
      "try {",
      "    const { tools } = await client.listTools();",
      "    $0",
      "} finally {",
      "    await client.close();",
      "}"
    ],
    "description": "TypeScript MCP stdio 클라이언트 연결과 종료"
  },

