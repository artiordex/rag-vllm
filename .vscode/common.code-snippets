  },
  "C++ GoogleTest": {
    "scope": "cpp",
    "prefix": "gtest",
    "include": ["*_test.cpp", "*_tests.cpp"],
    "body": [
      "TEST(${1:Suite}, ${2:Behavior}) {",
      "    EXPECT_EQ(${3:expected}, ${4:actual});",
      "}"
    ],
    "description": "GoogleTest 테스트"
  },

