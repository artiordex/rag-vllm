      "    $0",
      "    return 0;",
      "}"
    ],
    "description": "C++ 실행 진입점"
  },
  "C++ header": {
    "scope": "cpp",
    "prefix": "cppheader",
    "include": ["*.h", "*.hpp"],
    "body": [
      "#pragma once",
      "",
      "$0"
