    "description": "JavaScript React 함수형 컴포넌트"
  },
  "Playwright test": {
    "scope": "typescript,typescriptreact,javascript,javascriptreact",
    "prefix": "pwtest",
    "include": ["*.spec.ts", "*.test.ts", "*.spec.tsx", "*.test.tsx", "*.spec.js", "*.test.js"],
    "body": [
      "import { expect, test } from \"@playwright/test\";",
      "",
      "test(\"${1:scenario}\", async ({ page }) => {",
      "\tawait page.goto(\"${2:/}\");",
      "\tawait expect(page).toHaveTitle(/${3:title}/);",
      "});"
    ],
    "description": "Playwright 브라우저 테스트"
  },

