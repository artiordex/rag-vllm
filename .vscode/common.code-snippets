{
  // Python: 실행·함수·테스트
  "Python main": {
    "scope": "python",
    "prefix": "pymain",
    "body": [
      "def main() -> None:",
      "\t$0",
      "",
      "if __name__ == \"__main__\":",
      "\tmain()"
    ],
    "description": "Python 실행 진입점"
  },
  "Python function": {
    "scope": "python",
    "prefix": "pydef",
    "body": [
      "def ${1:function_name}(${2:}) -> ${3:None}:",
      "    \"\"\"${4:함수 설명}\"\"\"",
      "    ${0:pass}"
    ],
    "description": "타입 힌트가 있는 함수"
  },
  "Pytest test": {
    "scope": "python",
    "prefix": "pytest",
    "body": [
      "def test_${1:behavior}() -> None:",
      "    ${0:assert actual == expected}"
    ],
    "description": "pytest 테스트 함수"
  },

  // C/C++: 기본 실행 파일과 헤더
  "C++ main": {
    "scope": "cpp",
